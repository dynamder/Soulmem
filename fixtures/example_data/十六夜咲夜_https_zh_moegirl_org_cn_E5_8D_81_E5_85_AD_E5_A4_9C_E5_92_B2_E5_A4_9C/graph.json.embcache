"retrieval_count":0,"create_time":"2026-07-16T14:57:07.061640900Z","last_accessed_time":"2026-07-16T14:57:07.061640900Z","mem_type":{"Semantic":{"content":"飞刀","aliases":["银质飞刀","银刀","投掷刀"],"concept_type":"Entity","description":"这是我主要的武器，使用银质飞刀。由于银对大小姐是弱点，但作为武器很实用。银入手困难，近期在考虑其他材料。我的飞刀技术非常精准，能掷中二十间外头上有苹果的妖精女仆的额头。投掷飞刀水平和料理水平成正比。"}},"mem_links":[]}},{"embedding":{"tag":[0.0011284743,-0.0009226445,0.056991972,-0.018459465,0.016627368,-0.048941486,-0.053875454,0.034673255,-0.01570915,0.027374918,0.103308305,-0.31606668,-0.016117688,-0.024672655,0.02012852,-0.009549615,-0.0022372492,-0.007113821,-0.02576101,0.000039177598,0.033725224,-0.02293787,-0.0025708014,0.016625253,0.020538917,-0.011623086,0.0017840536,-0.053139873,-0.052899964,-0.042228915,-0.035053663,-0.018181019,-0.0055058743,0.04375851,0.0041044606,-0.0005417252,0.022696557,0.01773458,-0.033302505,0.018366331,-0.0029100818,0.062140234,-0.025666047,-0.018939115,0.007220496,-0.032860946,-0.032828927,0.01883104,0.017827736,0.03979563,0.016525254,0.020951953,0.04918157,0.057412203,0.03633929,-0.012887423,-0.027612304,0.004483316,-0.056512076,0.02397452,-0.0024628756,-0.06191257,0.009474579,0.0046764873,-0.04116301,-0.032331973,-0.025651336,0.04823348,0.009553493,0.0073699025,0.028783277,0.017540839,0.030389374,0.0048365686,0.0073295212,-0.08574226,-0.008866538,0.02626115,-0.0146299545,0.010036286,0.034083314,-0.07294017,0.008217556,0.04658047,0.017889643,-0.049346767,-0.008487549,0.017211642,-0.028568223,-0.033892985,-0.015927035,-0.06676653,0.048642725,0.070017785,-0.050261367,-0.021993212,-0.020943053,0.0051439623,0.004566269,-0.02083342,-0.0548954,0.042751007,0.0111340005,-0.016594214,-0.041966226,0.007514195,0.036147173,-0.04896554,0.06730549,0.04596199,0.016117252,-0.0070014177,-0.038990088,0.01088997,0.013623821,-0.000048941933,0.021037238,-0.011860175,-0.009515825,-0.0034673922,-0.013203146,-0.03179686,0.043669287,-0.008882239,-0.06374097,0.009700837,0.024039514,-0.003739791,0.00976048,0.0045984285,0.0946395