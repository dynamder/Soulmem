","last_accessed_time":"2026-07-16T15:16:30.347114700Z","mem_type":{"Semantic":{"content":"星期日","aliases":["鸡翅膀男孩","小鸡仔"],"concept_type":"Entity","description":"他是匹诺康尼的橡木家系家主。我假扮成知更鸟接近他，被他揭穿。他告诉我真正的知更鸟已被杀害，我提议继续假扮被拒绝。他后来想搞太一之梦，把我也困进梦境，我记着这笔账。"}},"mem_links":[]}},{"embedding":{"tag":[-0.022272067,0.012059003,0.066918306,-0.004821212,0.02561162,-0.05646918,-0.04505983,0.0486105,0.0034291293,0.030657418,0.112918794,-0.31927907,-0.03101869,-0.029109703,0.059655055,0.029519875,-0.026576746,-0.005809678,-0.051329687,-0.04163952,0.061302617,-0.07492714,-0.0174038,-0.019825231,0.038651954,-0.0144792255,0.0111561995,-0.030702226,-0.02658413,-0.00161321,-0.026377987,0.0052402676,0.011669052,0.01855581,0.01489514,0.04911354,0.0008569285,-0.024580553,-0.0014148754,0.001767009,0.005878618,0.0014390005,0.012284528,-0.009373272,-0.009919196,-0.0102938935,-0.041313037,0.008831081,-0.007829234,0.0017400458,-0.034281183,0.041567385,0.022625297,0.03275502,-0.015972117,-0.03511167,-0.027299836,0.050150007,-0.015601031,0.0354238,0.053306065,-0.044716455,-0.0032608379,0.036400206,0.018994369,-0.023621652,-0.04527466,-0.012401307,0.02026238,0.017694091,-0.023789067,-0.037369963,-0.00068444153,-0.02478678,0.020368226,-0.08246103,-0.018010926,0.017858146,0.014878265,-0.0122818835,0.06663907,-0.043636143,-0.036201596,0.022672132,-0.06154014,-0.013863162,-0.06670175,0.01175661,-0.03509604,-0.029157758,-0.0031741513,-0.063823685,0.045579594,0.043591388,-0.004413235,-0.0028710621,-0.055779777,0.014772169,0.013131289,0.03555431,-0.010233622,0.037555814,0.03661057,0.00013553165,-0.09040973,0.0035549218,0.026960406,-0.04409968,0.064350635,0.025919493,-0.0012754765,0.021738682,-0.025021024,-0.00086526014,0.025167396,-0.0048538316,0.0063812537,0.00674069,-0.014081928,0.06688583,-0.009242166,-0.0018331455,0.011130111,-0.07103934,-0.036743972,-0.033234745,0.03730096,-0.022153838,0.008513139,-0.0162561,0.089430645,-0.017134368,-0.065246195,-0.011085785,-0.01744781,-0.0076427176,0.025936976,-0.008272069