9,-0.08246859,-0.021278804,-0.025475124,-0.00035941086,-0.022974206,-0.011695824,0.025087003,0.019267216,-0.029854419,0.040363953,0.018066218,0.00589103]}}},"note":{"id":"c6524a91-474e-4489-a9d4-059db99f53d1","tags":["人物","开拓者"],"retrieval_count":0,"create_time":"2026-07-16T15:16:27.426124100Z","last_accessed_time":"2026-07-16T15:16:27.426124100Z","mem_type":{"Semantic":{"content":"开拓者","aliases":["小灰毛"],"concept_type":"Entity","description":"他是星穹列车的无名客。我给他起了外号‘小灰毛’；我假装桑博接近过他，把他和流萤拉进‘稚子的梦’；我假扮黑天鹅发短信骗他梦泡，被他识破；我还给他发过各种诈骗短信。我用烟花炸弹戏弄他，还把他一锤子打飞给流萤制造机会。最后我告诉他，是银狼雇我来当导演，确保流萤的三次‘死亡’安全实现。"}},"mem_links":[]}},{"embedding":{"tag":[-0.022978876,-0.029676553,0.061597817,-0.0057350094,-0.035586722,-0.051973335,-0.040143996,0.041106235,-0.0014177838,0.03497991,0.08931913,-0.27080554,-0.002970595,-0.066128224,0.025068581,0.025294334,-0.00037350692,0.008579047,0.01796244,-0.0023091745,0.038895395,-0.064029105,-0.047784872,0.020268552,0.011792069,-0.01900467,0.029131975,-0.023002524,-0.018115083,0.016313957,0.00428811,0.0177686,-0.007347704,0.04480076,0.014508114,0.019519055,0.03305468,-0.024680723,0.01009183,0.0085059395,-0.03959567,-0.011470976,0.014314522,-0.00248338,-0.018227123,-0.015751943,-0.03894282,0.042838495,-0.014152635,0.013216894,-0.03880211,0.016498376,-0.02322785,0.054042324,-0.006628223,-0.03526642,-0.0024452182,0.08745617,-0.032720737,0.03253945,0.040464558,-0.03371854,-0.03764832,-0.012029022,-0.004655051,-0.0235936,-0.041085213,0.006424076,0.015604291,0.033334993,-0.029847346,0.03366239,0.008138646,0.002083134,0.002835515,-0.03178148,0.012441462,0.0469089,0.004120865,0.018277043,0.005701666,-0.011612587,-0.024036521,0.014484195,-0.06884585,-0.04570162,-0.05380913,-0.03499589,-0.011182731,-0.0057816897,0.00472196,-0.058466487,0.071381055,0.021588663,-0.02884553,0.0152930925,-0.028127547,0.0029875087,0.00375701,-0.008695389,-0.0026618242,-0.0092594465,-0.00016815588,-0.0050560725,-0.06196799,0.03091959,0.036903165,-0.036586463,0.04545,0.015924389,-0.016148979,0.0563