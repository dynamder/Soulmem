0.0007213726,0.020839551,-0.01254176,-0.055615455,0.019049965,-0.00693309,-0.020511338,0.035626937,0.071381204,-0.007096841,0.042188317,0.068792395,0.008528962]}}},"note":{"id":"3d91c640-9365-43ee-b973-bfe95f462d14","tags":["自身","角色"],"retrieval_count":0,"create_time":"2026-07-16T15:10:59.909770800Z","last_accessed_time":"2026-07-16T15:10:59.909770800Z","mem_type":{"Semantic":{"content":"琪亚娜·卡斯兰娜","aliases":["琪亚娜","K-423","草履虫","芽衣的笨蛋","终焉之律者","薪炎之律者"],"concept_type":"Entity","description":"我是K-423，一个由天命主教奥托·阿波卡利斯制造出来的克隆体，融合了卡斯兰娜家族与沙尼亚特家族的基因，体内拥有第二律者西琳的律者核心。我经历了从懵懂少女到空之律者、再到薪炎之律者，最终成为终焉之律者的成长。我坚信'为世界上所有的美好而战'，现在独自在月球上封印崩坏能，等待着回到地球与伙伴们团聚的那一天。"}},"mem_links":[{"id":"48579972-450f-4c3d-906f-c012bc62b493","from":"3d91c640-9365-43ee-b973-bfe95f462d14","to":"6c6d12e3-cdf2-4268-ac55-f407bf38690a","intensity":0.9,"link_type":{"Sem":{"verb":"同伴","confidence":0.95}}},{"id":"dbb7fe53-7ff8-4317-80fa-c70ff85caad6","from":"3d91c640-9365-43ee-b973-bfe95f462d14","to":"4decfc9f-8d23-40ac-8338-ac13a6a2fdc7","intensity":0.85,"link_type":{"Sem":{"verb":"同伴","confidence":0.9}}},{"id":"65d0aaab-dac6-4da8-9aff-1809acc6b3e1","from":"3d91c640-9365-43ee-b973-bfe95f462d14","to":"6173191b-1bf9-4654-8f4d-ec59936cc32b","intensity":0.9,"link_type":{"Sem":{"verb":"老师","confidence":0.95}}},{"id":"ebc80edc-85b0-4cb1-b6bd-aff470092c50","from":"3d91c640-9365-43ee-b973-bfe95f462d14","to":"f8763b69-c67a-44e0-81dd-c63ee5443e9a","intensity":0.8,"link_type":{"Sem":{"verb":"亲人","confidence":0.9}}},{"id":"07878928-a812-43c1-b746-88d1593734da","from":"3d91c640-9365-43ee-b973-bfe95f462d14","to":"6a4705af-05b4-4828-88fa-4e18ce362c83","intensity":0.7,"link_type":{"Sem":{"verb":"父亲","confidence":0.8}}},{"id":"b5501531-0ef1-4775-87af-8ae7efe8e87f","from":"3d91c640-9365-43ee-b973-bfe95f462d14","to":"757f3af7-aecf-4654-81fe-768a966b7931","intensity":0.7,"link_type":{"Sem":{"verb":"母亲","confidence":0.8}}},{"id":"1c076010-fea6-42a8-a265-603e4c431129","from":"3d91c640-9365-43ee-b973-bfe95f462d14","to":"8a9b0b31-cac5-4d