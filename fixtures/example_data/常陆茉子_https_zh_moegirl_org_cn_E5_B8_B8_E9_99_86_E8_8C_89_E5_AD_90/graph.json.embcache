f-daccdd353d1f","from":"4eb3a33b-94a3-4cd5-ac8d-1b842f65b53c","to":"9855adec-5d05-4f9d-b3a4-c85c22e3a7b4","intensity":1.0,"link_type":{"Sem":{"verb":"恋爱","confidence":0.9}}},{"id":"433d10e5-7e08-4f75-ae5e-848a3a4caf7e","from":"4eb3a33b-94a3-4cd5-ac8d-1b842f65b53c","to":"7c30555f-43b6-4a7c-8bdd-6471271199de","intensity":0.8,"link_type":{"Sem":{"verb":"侍奉","confidence":0.9}}},{"id":"66ed08e8-ccef-403e-af6e-8c82c11ee409","from":"4eb3a33b-94a3-4cd5-ac8d-1b842f65b53c","to":"26e73314-3a99-4b36-a03d-81f7a846a4df","intensity":0.8,"link_type":{"Sem":{"verb":"同伴","confidence":0.9}}},{"id":"1deba3f9-ce32-4355-aa5a-4a09466d0c82","from":"4eb3a33b-94a3-4cd5-ac8d-1b842f65b53c","to":"3816143f-aa90-4d0d-8f41-e7ff65ced777","intensity":0.7,"link_type":{"Sem":{"verb":"好友","confidence":0.9}}},{"id":"475c2562-b94d-445d-bbf2-78b34daa55f8","from":"4eb3a33b-94a3-4cd5-ac8d-1b842f65b53c","to":"680839c4-fc5b-4243-9006-2351f12faec4","intensity":0.5,"link_type":{"Sem":{"verb":"同学","confidence":0.8}}},{"id":"2a9a2eee-2a7c-4659-9df8-390d0970937e","from":"4eb3a33b-94a3-4cd5-ac8d-1b842f65b53c","to":"53db55aa-5a69-43b3-9bee-38f54a76c354","intensity":0.5,"link_type":{"Sem":{"verb":"同学","confidence":0.8}}},{"id":"030cc662-3d44-45b2-a6bd-4629256d6cd4","from":"4eb3a33b-94a3-4cd5-ac8d-1b842f65b53c","to":"cedfee15-d61f-47a5-a67b-0ce09c4e81d5","intensity":0.8,"link_type":{"Sem":{"verb":"侍奉","confidence":0.9}}},{"id":"b6b440c1-dd94-4be4-ad90-09301054da00","from":"4eb3a33b-94a3-4cd5-ac8d-1b842f65b53c","to":"81b1fb5a-a32e-4637-bba6-6cc091d5c61f","intensity":0.9,"link_type":{"Sem":{"verb":"家乡","confidence":1.0}}},{"id":"332ddc4b-c6eb-4bf3-b885-5329b8c187bd","from":"4eb3a33b-94a3-4cd5-ac8d-1b842f65b53c","to":"b5287931-ea0b-4013-a6e9-c3675b7d0ce5","intensity":0.6,"link_type":{"Sem":{"verb":"关联","confidence":0.8}}},{"id":"cebc4276-65f0-45ad-8b1e-9780ef96d2e3","from":"4eb3a33b-94a3-4cd5-ac8d-1b842f65b53c","to":"3c87a355-5e66-42a2-b988-fc7a9256aa41","intensity":0.6,"link_type":{"Sem":{"verb":"关联","confidence":0.8}}}