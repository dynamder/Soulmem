粹光芒。我用三个问题试探了他/她的立场，之后在层岩巨渊、须弥、纳塔等地多次合作。他/她是一个可靠的盟友，但我也常在他/她身上看到那位血亲的影子。"}},"mem_links":[{"id":"fdeb2d24-5305-4b40-87b6-8c5e4b646b9e","from":"4d72871a-4e86-4396-b83a-000bcb9c2059","to":"ba61adcd-aee7-4439-9752-7f31a152fba3","intensity":0.9,"link_type":{"Sem":{"verb":"同伴","confidence":0.9}}}]}},{"embedding":{"tag":[-0.018170422,-0.0075737564,0.054223932,-0.015554277,0.0007125819,-0.0462978,-0.038155712,0.039089378,0.0012459386,0.043529935,0.111255,-0.31588092,-0.0033472348,-0.07314357,0.025093267,0.06450215,-0.010112789,0.008748287,-0.015661288,-0.031004714,0.023414819,-0.056937687,0.011423575,-0.0029095383,0.022192422,-0.0027251518,0.04692503,-0.057099268,-0.025178105,0.02649408,-0.01341515,-0.022993784,-0.013010664,0.021247694,0.04709053,0.045911238,0.024319753,-0.023905318,0.009383544,0.015126512,0.007812213,-0.0069288276,0.033837162,-0.020822965,-0.005869354,-0.040225238,-0.03171941,0.023049738,0.00760158,0.020562906,-0.020550273,0.048642974,0.0081850095,0.079521134,0.019295443,-0.04844854,0.0022810944,0.043463893,-0.005147123,0.012214517,0.02398729,-0.05815893,-0.01885699,0.016046772,0.015913067,-0.022784315,-0.046879686,-0.0076131886,0.03144267,0.03696324,-0.0042297468,-0.033744074,-0.010552116,-0.013361174,0.023752507,-0.059570946,-0.012731867,0.014492627,0.014156907,0.010473715,0.04176697,-0.03111472,-0.019592015,0.017569857,-0.08347764,-0.06302151,-0.08769607,0.0024697296,-0.013227419,-0.01565977,-0.004362232,-0.09054066,0.051546905,0.010344183,-0.022563562,-0.0076346425,-0.06207098,-0.02367603,-0.00210581,0.03103789,0.011969611,0.020247933,0.043890115,0.0018194488,-0.06573206,-0.0018060249,0.0306849,-0.047009267,0.09696603,0.014381958,0.020510016,-0.002345411,-0.00814713,-0.004870259,0.025619064,0.0166598,0.01415509,-0.0073973546,-0.0026462888,0.07988562,-0.029757814,0.0036518648,0.028988156,-0.06513626,0.024773434,-0.031306338,0.038306233,-0.042676758,0.030747011,-0.013921528,0.059302162,-0.025832359,-0.04787132,0.0064524356,-0.033833418,0.010892709,-0.002