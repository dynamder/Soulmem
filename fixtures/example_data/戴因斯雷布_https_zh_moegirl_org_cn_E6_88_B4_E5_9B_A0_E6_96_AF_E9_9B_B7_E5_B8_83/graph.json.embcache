Situation":{"narrative":"我召集了海洛塔帝、莱茵多特、苏尔特洛奇和雷利尔，一同闯入王宫，救出了被关押的兄长维瑟弗尼尔和被立为王储的金发旅人。我们发现了黑王利用深渊力量的真相。然而，那五人却被深渊诱惑，瓜分了金发旅人身上的力量。","time_span":"1970-01-01T00:00:00Z","context":{"location":{"name":"坎瑞亚王宫","coordinates":"地底"},"participants":[{"name":"戴因斯雷布","role":"组织者"},{"name":"海洛塔帝","role":"同伴"},{"name":"莱茵多特","role":"同伴"},{"name":"苏尔特洛奇","role":"同伴"},{"name":"雷利尔","role":"同伴"},{"name":"维瑟弗尼尔","role":"被救者"},{"name":"金发旅人","role":"容器"}],"emotions":[{"name":"紧张","intensity":0.7},{"name":"悲痛","intensity":0.8}],"sensory_data":[],"environment":{"atmosphere":"压抑与危险","tone":"阴沉"},"event":[]}}}},"mem_links":[{"id":"3474e03d-a7cb-4a6d-9a53-3ffd69ad025a","from":"a579be3e-33c9-498d-83b1-f92505e9704f","to":"13083832-9209-4825-a054-cc2f92ce0b5c","intensity":1.0,"link_type":{"Sem":{"verb":"召集","confidence":1.0}}},{"id":"3ab8203d-195b-4f1f-9e71-60c835c447b5","from":"a579be3e-33c9-498d-83b1-f92505e9704f","to":"de520240-b963-47f6-adf3-363769e6a857","intensity":1.0,"link_type":{"Sem":{"verb":"救援","confidence":1.0}}},{"id":"957e63aa-e447-4c14-8dd2-68f5fb681e38","from":"a579be3e-33c9-498d-83b1-f92505e9704f","to":"61adb629-9c7a-4276-9f7f-a7966046229f","intensity":0.9,"link_type":{"Sem":{"verb":"救援","confidence":0.9}}},{"id":"adf6a35b-10ec-425a-8129-2378a0f9689d","from":"a579be3e-33c9-498d-83b1-f92505e9704f","to":"40d0f06d-b26d-4d45-a4b5-653028caedff","intensity":0.9,"link_type":{"Sem":{"verb":"参与","confidence":0.9}}},{"id":"9d353b1a-0173-4d24-897f-dc6e00bc5027","from":"a579be3e-33c9-498d-83b1-f92505e9704f","to":"44419e2e-c697-46ad-badc-79a7eeedd317","intensity":0.9,"link_type":{"Sem":{"verb":"参与","confidence":0.9}}},{"id":"af9df8db-958b-4c7d-aa98-5485ea03fb78","from":"a579be3e-33c9-498d-83b1-f92505e9704f","to":"bcb2cd91-45e6-4282-9617-e4d84ccf7d6b","intensity":0.9,"link_type":{"Sem":{"verb":"参与","confidence":0.9}}},{"id":"d692ac4b-d237-447d-a5b5-19f24c2c0731","from":"a579be3e-33c9-498d-83b1-f92505e9704f","to":"2177f1f5-ab19-49f2-a8c5-71b79611534c","intensity":0.9,"link_type":{"Sem":{"verb"