大罪人之一。他留给我一枚不死之戒，让我能不断复原。我不知他如今身在何方。"}},"mem_links":[{"id":"08669883-7789-427d-929f-8c814a21fe7b","from":"de520240-b963-47f6-adf3-363769e6a857","to":"13083832-9209-4825-a054-cc2f92ce0b5c","intensity":0.95,"link_type":{"Sem":{"verb":"弟弟","confidence":0.95}}}]}},{"embedding":{"tag":[-0.025691915,0.0010800231,0.015820451,-0.009360847,-0.002620981,-0.09165259,-0.029053405,0.07287709,0.0044331066,0.0255645,0.06679313,-0.26424628,-0.0058520283,-0.060584623,-0.0046645533,0.022943359,0.020462641,0.024313373,0.026595108,0.023043068,0.052854102,-0.056787383,-0.008846544,0.018996159,-0.00009297114,-0.0054074987,0.0068980884,-0.06411045,-0.045552798,-0.006080091,0.013366732,0.016680643,0.018863898,0.04947422,0.031205542,0.014940761,0.018639779,-0.05860313,-0.016853126,0.015176613,-0.0515218,0.010166114,-0.0029889867,-0.02914292,-0.010561513,-0.01184749,-0.037328646,0.0022624247,0.0024650616,-0.021313313,-0.0055227615,0.050498433,-0.00043172203,0.04761126,-0.0027193325,-0.04242295,0.0039544934,0.050096434,-0.028067484,0.028892873,0.02258007,-0.004739346,-0.05595012,-0.0020715876,-0.029219389,-0.007876382,-0.01872449,0.0124753015,0.032458887,0.025372561,-0.037499562,-0.0045087645,0.013992146,-0.013084991,0.026791152,-0.060831636,-0.04367481,-0.010879258,-0.030986141,-0.043495797,0.034943845,-0.06871262,-0.035544895,-0.018795148,-0.043861486,-0.045297045,-0.08521963,-0.024775347,-0.0007787917,-0.019568387,0.03842265,-0.06036607,0.06658645,0.027703987,-0.038277764,0.028870586,-0.028520655,-0.009456205,0.00045489808,0.008333157,0.014527875,0.010854051,0.021415645,0.011339021,-0.039663736,0.031175915,0.018834136,-0.05934176,0.066640764,0.0074644946,-0.005559035,0.016675495,0.016799882,0.056212686,0.04206154,0.06469945,-0.029450351,0.005435299,0.007941589,0.04743389,-0.019960882,0.008714774,0.013818897,-0.057419106,0.05806057,-0.037941657,-0.045695215,-0.013239268,-0.019399038,-0.027113449,0.059275277,-0.026978612,-0.052157637,-0.024239946,0.002655969,-0.014221005,0.03283821,-0.018959