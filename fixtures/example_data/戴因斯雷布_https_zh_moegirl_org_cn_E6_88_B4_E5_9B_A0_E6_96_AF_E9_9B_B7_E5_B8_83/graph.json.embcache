他是我的剑术启蒙者，黑蛇剑术的传授者。他不是一个好老师，打压新一辈的骑士，经常体罚我和苏尔特洛奇。五百年后在纳塔再次相遇时，他已沦为深渊走狗，我杀了他一百遍，又被他欺骗后再次杀了一百遍。他从未教会我什么是真正的骑士之道。"}},"mem_links":[]}},{"embedding":{"tag":[0.00014501438,-0.0024200026,0.028060403,0.012429336,-0.01244975,-0.061276734,-0.050460845,0.04030019,0.00785796,0.017873108,0.107211396,-0.29347116,-0.005735176,-0.069362186,0.0292031,0.022125393,-0.001374241,0.0053104283,-0.019331073,-0.011165776,0.012987096,-0.06553496,-0.032773476,-0.0033174139,0.012822634,-0.033777647,0.03620185,-0.07246266,-0.03416745,0.020183288,-0.011467924,0.008769009,-0.031454187,0.017861769,0.044523984,0.02505005,0.024985988,-0.025959343,-0.009885473,0.013084996,-0.070575535,-0.003637433,0.033035696,-0.027186818,-0.011434667,-0.02275945,-0.037158165,0.021112984,-0.04524284,0.011759218,-0.036400016,0.050054185,-0.005905295,0.07028535,-0.010872482,-0.031018214,0.03776844,0.077968545,0.023548648,-0.010098036,0.021001982,-0.044225,-0.030306611,0.009127522,-0.019025188,0.021652088,0.0032291748,0.010152229,0.038780473,0.054426305,-0.016420247,-0.023595631,-0.024528354,0.011149479,0.02471507,-0.025277225,-0.021755818,0.018958073,-0.012037921,0.0061262585,0.05349572,-0.059223436,-0.055821467,0.027125401,-0.042703874,-0.018516593,-0.09076739,-0.0084759565,-0.016807063,-0.027098224,0.011349464,-0.08480336,0.07906697,0.04193321,0.0041005444,0.009880667,-0.03622896,-0.014957422,0.008252297,-0.0023093522,-0.00006499607,-0.0018727165,0.02944766,0.016355604,-0.09099987,-0.005301631,0.024735685,-0.019576648,0.075893104,0.006458508,0.0044904845,0.020637143,-0.008060111,0.014989955,0.0024645347,0.04067471,0.04022598,0.03238005,0.020558525,0.07221909,-0.01885605,-0.012736058,0.024742618,-0.073407836,0.009388203,-0.048578896,0.044618882,-0.02003422,0.03470191,-0.014701726,0.045353368,-0.036685586,-0.04090825,0.00067050755,-0.046375073,0.01604234,0.0112658255,-0.05475214,-0.010181714,0.0057605184,-0.0046899905,-0.0035344115,-0.01869786,-0.024790261,0.026843524,-0.005608105,0.026598519,0.009976271,0.009251911,-0