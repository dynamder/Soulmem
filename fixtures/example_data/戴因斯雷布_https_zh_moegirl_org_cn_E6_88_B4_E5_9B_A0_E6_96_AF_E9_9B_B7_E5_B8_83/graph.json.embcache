:{"Semantic":{"content":"派蒙","aliases":["应急食品","漂浮的小家伙","旅行者的伙伴"],"concept_type":"Entity","description":"一个漂浮在旅行者身边的小家伙，自称是「最好的伙伴」。她的斗篷上有星空图案，与我的斗篷有几分相似。她活泼话多，有时让我烦躁，但对旅行者忠诚。我猜测她的身份不简单，但不打算深究。"}},"mem_links":[]}},{"embedding":{"tag":[-0.020093117,-0.0036830595,0.05162839,-0.0016507502,0.0016994849,-0.064625755,-0.0476309,0.048696052,-0.0034301942,0.0036986656,0.09002322,-0.30769807,-0.020360649,-0.058537446,0.028151931,0.04641184,0.00093512796,-0.01570477,0.017485335,-0.018931836,0.035449456,-0.09156862,0.007460071,-0.010573621,0.023721192,-0.0130168125,0.048309796,-0.08942732,-0.0201292,0.030230328,-0.039918784,-0.010377488,0.010460868,0.0130451005,0.05599832,0.05923689,0.03035408,-0.028951693,0.0024802403,-0.006549283,-0.046541538,-0.020433879,0.018328961,-0.024243437,-0.0133910235,-0.023387253,-0.056669094,0.011518814,-0.01248963,-0.032290496,-0.050375953,0.039627973,0.0130456835,0.04144836,0.02863267,-0.054678258,0.037147425,0.049091514,0.012041967,0.011238685,-0.017251793,-0.01778626,0.00048924796,-0.0030065905,-0.011369079,-0.023897318,-0.04042098,0.0023496877,0.032421373,0.055290412,-0.0393309,0.0038245637,-0.005374213,-0.0068674562,-0.0146175735,-0.05756981,-0.060426295,-0.0031235074,0.014049832,-0.0014783209,0.032236166,-0.062625766,-0.027474513,0.007609038,-0.039101936,-0.047070898,-0.09264921,-0.029715054,-0.02162487,-0.021869022,0.0020006234,-0.084522404,0.049592365,0.036085695,-0.002569561,0.010747901,-0.055571396,0.00513231,-0.024487076,-0.032257378,0.026392775,0.018871311,0.013687117,0.0023953922,-0.042317275,0.005217219,0.011337026,-0.027980048,0.10155172,0.027670402,0.010085124,-0.020990957,-0.021987194,0.0063151494,0.034524933,0.022262553,-0.018259283,0.001535556,-0.0020341296,0.049761727,0.00677625,0.02694332,0.030740287,-0.04942522,0.051755216,-0.0063121878,0.023701485,-0.02779118,0.027292691,0.008129285,0.085191116,-0.0309764,-0.050921123,-0.023384174,-0.013858197,0.00024106307,-0.0006853603,-0.0059246486,-0.040901083,0.024769006,-0.002406708,-0