    "mem_type": {
      "Semantic": {
        "content": "玛丽安·吉约丹",
        "concept_type": "Entity",
        "description": "她是我的义妹，我们在水仙十字院一起长大。她坚强、关心他人，经常责备我因研究而忽视生活。我们一起加入逐影庭，后在厄里那斯体内与纯水精灵莉利丝融合成为纯水精灵。我从未停止思念她，并以此创造了小玛丽安。",
        "aliases": ["玛丽安", "妹妹", "义妹"]
      }
    },
    "tags": ["人物", "家人", "妹妹"]
  },
