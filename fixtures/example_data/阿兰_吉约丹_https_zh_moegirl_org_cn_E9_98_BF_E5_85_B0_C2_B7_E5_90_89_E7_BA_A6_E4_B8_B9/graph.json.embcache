on":{"narrative":"在厄里那斯的体内，水仙十字结社和逐影庭之间展开了决战。玛丽安与纯水精灵莉利丝融合，西摩尔损毁，雅各布失踪，雷内化名大师投身格式塔下的原始胎海。我默默关上门离开了，并未彻底搜查格式塔。","time_span":"1970-01-01T00:00:00Z","context":{"location":{"name":"厄里那斯体内","coordinates":""},"participants":[{"name":"我","role":"逐影庭成员"},{"name":"玛丽安","role":"逐影庭成员/融合者"},{"name":"雷内","role":"结社首领"},{"name":"雅各布","role":"结社成员"},{"name":"西摩尔","role":"机器狗"},{"name":"莉利丝","role":"纯水精灵"}],"emotions":[{"name":"决绝","intensity":0.8},{"name":"悲伤","intensity":0.7}],"sensory_data":[],"environment":{"atmosphere":"压抑与终结","tone":"阴郁"},"event":[{"action":"融合","action_intensity":1.0,"initiator":"玛丽安","target":"莉利丝"},{"action":"投身原始胎海","action_intensity":1.0,"initiator":"雷内","target":"格式塔"},{"action":"离开","action_intensity":0.5,"initiator":"我","target":"战场"}]}}}},"mem_links":[{"id":"d481106e-e02c-4385-8d89-258bccdf80a2","from":"e41b3e8f-bec3-4593-837a-d316e571f54f","to":"8f58c070-5ec3-4d7f-b595-c0db3fadac6b","intensity":0.8,"link_type":{"Sem":{"verb":"参与","confidence":1.0}}},{"id":"1395006a-c259-4ad9-9202-e0d52ea6e751","from":"e41b3e8f-bec3-4593-837a-d316e571f54f","to":"c08a73d6-540d-4416-8f3f-802b0c38f514","intensity":0.8,"link_type":{"Sem":{"verb":"参与","confidence":1.0}}},{"id":"859febd6-c747-4e0f-b18d-94a6d3f29e25","from":"e41b3e8f-bec3-4593-837a-d316e571f54f","to":"bff98b12-6b19-41f2-8c53-ed8652221fa7","intensity":0.8,"link_type":{"Sem":{"verb":"参与","confidence":1.0}}},{"id":"1fa73089-cc61-4300-b882-7b398ef45073","from":"e41b3e8f-bec3-4593-837a-d316e571f54f","to":"b74d7b55-2270-4169-966a-309446fa1f53","intensity":0.8,"link_type":{"Sem":{"verb":"参与","confidence":1.0}}},{"id":"c44f1636-b90d-41a3-a707-407b91229916","from":"e41b3e8f-bec3-4593-837a-d316e571f54f","to":"7e46669b-a0c6-436a-9b7a-cf22f187c510","intensity":0.8,"link_type":{"Sem":{"verb":"参与","confidence":1.0}}},{"id":"93742223-5635-4829-b8ad-91851bda0408","from":"e41b3e8f-bec3-4593-837a-d316e571f54f","to":"9d94f7cc-2232-4679-ad90-df1940104ab3","intensity":0.8,"link_type":{"Sem":{"verb":"涉及组织","confidence":1.0}}},{