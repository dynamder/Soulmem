icSituation":{"narrative":"被困在量子之海后，我在那片没有星星和亮光的空间里独自一人度过了很长很长的时间。为了寄托希望和确认自己的存在，我开始写日记，记录下美好的回忆。我始终相信布洛妮娅姐姐会来接我。","time_span":"1970-01-01T00:00:00Z","context":{"location":{"name":"量子之海","coordinates":""},"participants":[{"name":"希儿·芙乐艾","role":"被困者"}],"emotions":[{"name":"孤独","intensity":0.9},{"name":"希望","intensity":0.8}],"sensory_data":[],"environment":{"atmosphere":"寂静黑暗","tone":"压抑"},"event":[{"action":"等待","action_intensity":0.9,"initiator":"希儿·芙乐艾","target":"布洛妮娅·扎伊切克"},{"action":"写日记","action_intensity":0.6,"initiator":"希儿·芙乐艾","target":"日记本"}]}}}},"mem_links":[{"id":"59d25aea-f941-478f-973a-ab721aff23dc","from":"e017ad82-74c9-4fad-a8ad-12a35f7c0554","to":"978b9103-6fab-444a-b118-43edea483d8e","intensity":0.9,"link_type":{"Sem":{"verb":"经历者","confidence":0.9}}},{"id":"2b7a614e-6c53-4bf9-bf72-65e08367ceb4","from":"e017ad82-74c9-4fad-a8ad-12a35f7c0554","to":"28358106-dc4f-4d0a-90c9-2ad869b2dded","intensity":0.9,"link_type":{"Sem":{"verb":"场所","confidence":0.9}}},{"id":"92f18128-3373-4478-b1f3-889046fd6925","from":"e017ad82-74c9-4fad-a8ad-12a35f7c0554","to":"5d24537e-932c-4855-820d-cb5b88c805da","intensity":0.5,"link_type":{"Sem":{"verb":"有关","confidence":0.5}}}]}},{"embedding":{"tag":[0.0358545,0.04427532,0.019981405,-0.013760103,-0.024342213,-0.032922056,-0.020765401,0.041592397,-0.042560153,0.024877002,0.10316132,-0.32349956,0.025457276,-0.035041474,-0.028383419,0.022416204,-0.028356202,0.006336516,0.003223678,-0.07356359,0.013754688,-0.06034986,0.018118436,0.027211884,0.006874003,0.0027206978,0.017161038,-0.051893577,-0.022346608,-0.037024997,-0.0099219,-0.03875078,0.016170882,0.031592436,0.015115785,0.026713563,-0.031314485,-0.027105577,-0.024622012,0.03209131,-0.039543804,0.026438674,-0.007982197,-0.02586548,-0.032809895,-0.033750523,-0.028798774,0.0790841,-0.020455837,0.024143625,0.009095987,0.045755528,0.050878473,0.011895068,0.045584828,-0.046943653,-0.006380496,0.021266937,-0.009368714,-0.01933418,0.0034248983,0.009913234,-0.016793057,0.024304437,-0.0