":0.5}}}]}},{"embedding":{"tag":[0.014125591,0.017186843,0.043753825,0.011065079,0.00870248,-0.040203083,-0.043450553,0.05459227,0.00014944666,0.0508752,0.11672443,-0.29898632,-0.02042427,-0.0708299,0.021328792,-0.0029669125,0.002499641,0.0004194891,-0.040511146,-0.007489128,0.028785598,-0.075326286,0.008551866,-0.0011031977,0.027865443,-0.012696462,0.04131124,-0.10289659,-0.041990645,0.023839692,-0.03144287,-0.010518917,-0.03717258,0.029430583,0.048682347,0.024635743,0.041159794,-0.034637008,0.011735447,0.03155719,-0.034430154,-0.0198744,0.05556512,0.0012269439,-0.0094091585,-0.037397277,-0.04522858,0.0070199165,-0.006766451,-0.006691561,-0.048927285,0.046968594,-0.0025840611,0.08000635,0.003221632,-0.028186928,0.04964369,0.048020333,0.019555356,0.007259296,0.019266123,-0.045186985,-0.022200936,-0.014097443,0.0017452473,-0.017081054,-0.041652735,0.013158652,0.023702506,0.04798702,-0.014485881,-0.0141253425,-0.010124361,-0.010983145,-0.012086852,-0.04953578,-0.03643358,0.025656145,-0.010719849,-0.016614018,0.04757814,-0.059196685,-0.036958877,0.038340088,-0.054142162,-0.03733685,-0.08701101,-0.017901743,-0.019977525,-0.023498617,-0.0001791669,-0.107756704,0.052254926,0.051743537,-0.0009465879,0.0065469397,-0.064386874,-0.013204904,0.004964634,-0.0059920438,-0.00500717,-0.010587943,0.035147164,0.025692655,-0.07923823,-0.0074841483,0.043451533,-0.024481785,0.08987448,0.016007671,-0.009684136,0.0040409286,-0.02739003,0.019633982,0.011671409,0.003710525,0.028851012,0.0057174503,0.014136024,0.06639078,0.014969094,-0.0012697205,0.04233075,-0.07281062,0.009837693,-0.039438922,0.049824215,-0.018425955,0.02244943,-0.019617708,0.08693862,-0.042284247,-0.061093822,-0.010627443,-0.02807411,0.014732233,0.022596756,-0.018915266,-0.025653962,-0.013813073,0.0081703905,-0.023060441,-0.005698424,-0.044539746,0.0076561803,0.0038434444,0.033698283,0.020517994,0.009467009,-0.0067603765,0.04741088,-0.050627727,-0.028123733,0.006056851,-0.00785428,0.001638598,0.009842246,0.020503428,-0.03