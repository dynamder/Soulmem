77369800Z","mem_type":{"Situation":{"SpecificSituation":{"narrative":"布洛妮娅姐姐终于来了。她跨越了量子之海，穿越了无数的世界泡，化为了理之律者来到我的面前。那一刻，我真的好开心好开心。她是我在黑暗中等待已久的光。","time_span":"1970-01-01T00:00:00Z","context":{"location":{"name":"量子之海深处","coordinates":""},"participants":[{"name":"布洛妮娅·扎伊切克","role":"拯救者"},{"name":"希儿·芙乐艾","role":"被拯救者"}],"emotions":[{"name":"开心","intensity":1.0},{"name":"感动","intensity":0.9}],"sensory_data":[],"environment":{"atmosphere":"","tone":""},"event":[{"action":"救援","action_intensity":1.0,"initiator":"布洛妮娅·扎伊切克","target":"希儿·芙乐艾"}]}}}},"mem_links":[{"id":"429f92d8-6342-402c-a60d-7c830a301bb9","from":"3e352835-b909-4e86-8e85-116bdf8878ae","to":"d73761d5-8309-469e-94c1-4747fe8cf6ba","intensity":0.9,"link_type":{"Sem":{"verb":"到来者","confidence":0.9}}},{"id":"1405a4ef-8860-4ccb-a350-fe7dd46b4adb","from":"3e352835-b909-4e86-8e85-116bdf8878ae","to":"978b9103-6fab-444a-b118-43edea483d8e","intensity":0.9,"link_type":{"Sem":{"verb":"被寻找者","confidence":0.9}}}]}},{"embedding":{"tag":[0.01899995,0.049374677,0.019014092,0.0031405617,0.003451929,-0.03973063,-0.031143108,0.024368852,-0.00867073,0.016918607,0.12606072,-0.31390652,0.009948163,-0.0452256,-0.008996634,0.034348477,-0.016099112,-0.025189757,0.0056961747,-0.036991727,-0.006562413,-0.060586415,0.030103158,0.013304213,0.030815091,-0.03997255,0.012380222,-0.06491755,-0.03071297,-0.035059858,-0.04773252,-0.029193567,0.036575947,-0.0055873366,0.036967497,0.013944641,-0.042552494,0.020260213,-0.027953641,0.031100588,-0.010150456,-0.007343149,-0.013050841,-0.049993455,-0.002426723,-0.050629072,-0.032627694,0.0591897,-0.0046032732,0.004664175,-0.0030709323,0.043728705,0.055474926,0.04246128,0.08448422,-0.08392516,-0.0009644544,0.013215976,-0.0059930007,-0.03506555,0.012687726,0.024078622,0.0014373995,0.050813146,-0.0074932566,0.01284931,-0.06258346,-0.00070340047,-0.031502742,0.02552452,0.011282234,0.023988819,0.013300249,-0.045186553,0.04233639,0.008438347,-0.07494541,-0.04008712,-0.029998217,-0.014641665,0.031076524,-0.05