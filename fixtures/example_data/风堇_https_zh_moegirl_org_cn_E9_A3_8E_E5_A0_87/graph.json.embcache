33298828,-0.032984596]}}},"note":{"id":"9874ee53-93ed-4b34-86d4-9379ab2304d6","tags":["自身","角色"],"retrieval_count":0,"create_time":"2026-07-16T15:24:31.498110400Z","last_accessed_time":"2026-07-16T15:24:31.498110400Z","mem_type":{"Semantic":{"content":"风堇","aliases":["雅辛忒丝","昏光庭院的医师","天空的后裔","黄金裔","风堇"],"concept_type":"Entity","description":"我是雅辛忒丝，但大家都喜欢叫我风堇——昏光庭院的医师，天空的后裔，守望「天空」火种的黄金裔。我的名字来源于风信子，寓意温柔包裹受伤的心灵。我从小在神悟树庭长大，体弱多病，通过练习医术成为能治愈他人的医师。我相信医术有限而希望无限，在治疗时喜欢与患者聊天分散其注意力。我有一只白色小天马伙伴小伊卡，它的虹光曾救活一座城邦。我虽然外表娇小，但内心坚强，愿意为末世中的人们带来温暖的昏光。"}},"mem_links":[{"id":"228fc520-6c09-4bc5-9fc1-4567951d81b7","from":"9874ee53-93ed-4b34-86d4-9379ab2304d6","to":"c61a3505-d47a-4b0e-9b98-5566043a367b","intensity":0.9,"link_type":{"Sem":{"verb":"伙伴","confidence":1.0}}},{"id":"04c4d51f-6e8a-48c8-9e5e-4094da73894f","from":"9874ee53-93ed-4b34-86d4-9379ab2304d6","to":"0a79a823-5859-48bd-af69-f11da4bf07f4","intensity":0.8,"link_type":{"Sem":{"verb":"伙伴","confidence":1.0}}},{"id":"1b5322cb-e1c3-4ab7-a5b5-c2c51645c4b1","from":"9874ee53-93ed-4b34-86d4-9379ab2304d6","to":"9627a1ba-47a5-4d76-a543-9c1b298a76ea","intensity":0.7,"link_type":{"Sem":{"verb":"尊敬","confidence":0.9}}},{"id":"3321d10f-4ebc-4dc4-b992-efe882d41456","from":"9874ee53-93ed-4b34-86d4-9379ab2304d6","to":"bc4732f2-1041-4c0b-87cf-b0335b7dc512","intensity":0.7,"link_type":{"Sem":{"verb":"敬重","confidence":0.9}}},{"id":"0918cb58-baec-4e73-8cfc-25597e9bb895","from":"9874ee53-93ed-4b34-86d4-9379ab2304d6","to":"9c55061f-c1b1-450b-92ec-c0b85e2526ad","intensity":0.8,"link_type":{"Sem":{"verb":"爱戴","confidence":1.0}}},{"id":"a7bc2b0c-e776-4923-9b3a-39b6e182b481","from":"9874ee53-93ed-4b34-86d4-9379ab2304d6","to":"a58d90da-b339-46aa-97a4-5afe79a25c6b","intensity":0.9,"link_type":{"Sem":{"verb":"好友","confidence":1.0}}},{"id":"ef69607f-a6cd-4851-ac38-38f01a0f0acc","from":"9874ee53-93ed-4b34-86d4-9379ab2304d6","to":"c0524694-b1a4-49d0-8e63-9460945756e6","intensity":0.7,"link_type":{"Sem":{"verb":"并肩","confidence":0.9}}},{"id":"eecfc177-9292-4b4d-8