88-b027-e1329c538bf6","tags":["重要事件","传承","往世乐土"],"retrieval_count":0,"create_time":"2026-07-16T15:22:49.368476600Z","last_accessed_time":"2026-07-16T15:22:49.368476600Z","mem_type":{"Situation":{"SpecificSituation":{"narrative":"在世界蛇期间，我被派往前往往世乐土，一个保存前文明英桀记忆体的虚拟空间。在这里，我遇到了爱莉希雅、阿波尼亚、伊甸、维尔薇、樱、华等英桀。他们向我展示了前文明的故事。最终爱莉希雅将始源之力传承给我，使我成为始源之律者。","time_span":"1970-01-01T00:00:00Z","context":{"location":{"name":"往世乐土","coordinates":"虚拟空间"},"participants":[{"name":"爱莉希雅","role":"传承者"},{"name":"逐火十三英桀","role":"记忆体"},{"name":"雷电芽衣","role":"探索者"}],"emotions":[{"name":"好奇","intensity":0.7},{"name":"感动","intensity":0.8},{"name":"决心","intensity":0.9}],"sensory_data":[],"environment":{"atmosphere":"神秘而庄重","tone":"史诗"},"event":[{"action":"探索","action_intensity":0.6,"initiator":"雷电芽衣","target":"往世乐土"},{"action":"获得传承","action_intensity":1.0,"initiator":"爱莉希雅","target":"雷电芽衣"}]}}}},"mem_links":[{"id":"3f3eb6c4-e72e-4e91-a836-3a32c200a488","from":"94d65da8-a604-4288-b027-e1329c538bf6","to":"8c58514b-e6b3-4070-95a1-198149ebf7f9","intensity":1.0,"link_type":{"Sem":{"verb":"探索","confidence":1.0}}},{"id":"be5040c6-b912-4e1e-9955-33adca9dc934","from":"94d65da8-a604-4288-b027-e1329c538bf6","to":"1c36e068-3db7-484b-8f83-c7cc50ecef53","intensity":1.0,"link_type":{"Sem":{"verb":"遇见","confidence":1.0}}},{"id":"26641930-b83f-4ed8-a766-68f017c8c576","from":"94d65da8-a604-4288-b027-e1329c538bf6","to":"3b696020-bd14-42bb-9b9a-a625da94783a","intensity":1.0,"link_type":{"Sem":{"verb":"地点","confidence":1.0}}}]}},{"embedding":{"tag":[0.034475494,-0.01598561,0.05028002,-0.04360786,-0.008256807,-0.047312003,-0.0037258565,0.022476315,-0.010850129,0.031717878,0.07190647,-0.29425722,-0.015605125,-0.02188039,0.005561736,0.02284357,-0.019189222,-0.015510737,-0.045727227,-0.027448261,0.0018171197,-0.047572594,0.011222526,-0.01731002,0.014963717,-0.0057444707,-0.014100681,-0.010898743,-0.00080276345,-0.01901809,-0.03081636,-0.012034364,0.003015415,0.047311176,-0.001447722,-0.00002440686,0.0063753366,-0.03463359,0.