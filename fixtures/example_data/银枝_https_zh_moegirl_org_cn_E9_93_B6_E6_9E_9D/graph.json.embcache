79,-0.01565973,-0.016529365,0.091630414,0.052224852,0.05370966,0.037773672,0.03606985,-0.06496413,0.043956537,-0.082907185,0.06799348,0.001455521,-0.034107428,-0.0024788328,0.014774899,-0.04132486,-0.05320838,0.019901501,0.043729912,-0.03329562,-0.027353704,0.030140601,-0.02155787,-0.05019022,0.026195098,0.054304577,0.07298568,-0.015951393,-0.039329898,0.0042558433,0.0068266233]}}},"note":{"id":"d09d130c-0bbf-45f7-a490-ba08787d6d48","tags":["角色","纯美骑士团"],"retrieval_count":0,"create_time":"2026-07-16T15:19:07.128945700Z","last_accessed_time":"2026-07-16T15:19:07.128945700Z","mem_type":{"Semantic":{"content":"曾经的同行骑士","aliases":["挚友","堕落的审美者"],"concept_type":"Entity","description":"他曾是与银枝同行的纯美骑士，坚信盔甲上有女神的祝福。但再次遇见他时，他已变成迷失在追求力量之路上的审美者——铠甲化为巨兽鳞皮，武器成为爪牙，血成火焰，双眸只余野性。他曾唤银枝挚友，如今只余嘶嘶叫声。这让银枝一度恐惧自身是否也会同样堕为恶兆。"}},"mem_links":[{"id":"1d5a065f-e618-44e8-b1ff-85e84dbf4a68","from":"d09d130c-0bbf-45f7-a490-ba08787d6d48","to":"8b272c45-c506-438c-9f33-113e97d1b5f1","intensity":0.8,"link_type":{"Sem":{"verb":"同伴","confidence":0.8}}}]}},{"embedding":{"tag":[-0.026698908,0.042029195,0.03258076,-0.0020828657,0.0022443873,-0.047932774,0.002232261,0.04081224,0.021522354,0.014695246,0.06495153,-0.29988205,-0.012266749,-0.010935817,-0.0019568014,0.012931154,-0.030652396,0.005154893,0.009677047,-0.0051337546,0.02382562,-0.08058745,0.016512966,-0.011703467,0.014824802,-0.027914535,0.018042296,-0.048058253,-0.024699528,-0.009715762,-0.045799427,0.03398458,0.027220162,0.0064002546,0.043173306,0.057112552,0.01915447,0.012171162,-0.002905136,0.011081506,-0.005435437,-0.026840102,0.015857307,-0.04484769,-0.029064087,-0.02013329,-0.0322747,0.01594356,-0.011338802,0.017331054,-0.048062596,0.044222917,0.04796044,0.02486077,0.022748085,-0.045328632,0.017886793,0.054126777,0.00891556,0.016168784,-0.03242345,-0.01799355,-0.007529456,0.025758943,-0.014839016,-0.022452163,-0.014885298,0.009505219,0.021913236,0.0356382,-0.034174033,0.024059117,0.01949338,0.00538876,0.018445635,-0.05533223,-0.06637766,0.01958