027,-0.024153855,0.0058239037,-0.08300755,0.085835055,-0.025606623,-0.055131953,-0.032862086,0.0022137251,-0.03569404,-0.021022806,0.026804743,-0.0059703984,-0.07795043,-0.06632547,0.04017271,0.01800323,-0.05209276,0.08565327,0.03608361,0.03765933,-0.026003279,0.0338537,0.006807532,-0.0027580063]}}},"note":{"id":"8b272c45-c506-438c-9f33-113e97d1b5f1","tags":["自身","角色"],"retrieval_count":0,"create_time":"2026-07-16T15:18:51.873560100Z","last_accessed_time":"2026-07-16T15:18:51.873560100Z","mem_type":{"Semantic":{"content":"银枝","aliases":["银枝","纯美骑士","授勋骑士"],"concept_type":"Entity","description":"我是纯美骑士团的授勋骑士，诞生于战火纷飞的星球。我拥有赤红长发、翠绿瞳孔，身披银白甲胄，手持银色长枪。我驾驶飞船「希世难得」在银河间游历，向宇宙播撒女神伊德莉拉的美名。我痴迷一切美的事物，遵循骑士道，以虔诚的战代替吟咏的诗。我曾经历镜之试炼，斩下三重魔鬼的诱惑。我为人正直、光明磊落，在银河中寻觅纯美的真谛。"}},"mem_links":[{"id":"ebc78ba6-f059-4123-ba00-eff74dc46436","from":"8b272c45-c506-438c-9f33-113e97d1b5f1","to":"7af29881-1584-4d7d-8a57-e463126ea196","intensity":0.95,"link_type":{"Sem":{"verb":"侍奉","confidence":0.95}}},{"id":"56bbcace-9f88-4c11-be20-a7de3c04b06c","from":"8b272c45-c506-438c-9f33-113e97d1b5f1","to":"04443bc8-d9d4-470e-9322-b04f97f49c58","intensity":0.9,"link_type":{"Sem":{"verb":"同伴","confidence":0.9}}},{"id":"1ae21ca5-d61c-4c78-b6c6-594d83bb5b8e","from":"8b272c45-c506-438c-9f33-113e97d1b5f1","to":"d4856a75-0731-4a67-8059-e9a6d86810e4","intensity":0.7,"link_type":{"Sem":{"verb":"认识","confidence":0.7}}},{"id":"034df18c-f702-48f3-9d9a-111e5296bb3e","from":"8b272c45-c506-438c-9f33-113e97d1b5f1","to":"e1b39342-b2d5-4bec-874f-a0144877fef9","intensity":0.7,"link_type":{"Sem":{"verb":"认识","confidence":0.7}}},{"id":"7b562b02-854d-4595-ba51-a4281c38f6ad","from":"8b272c45-c506-438c-9f33-113e97d1b5f1","to":"2b3fa471-1258-4784-aa3c-8fcf5004475e","intensity":0.7,"link_type":{"Sem":{"verb":"认识","confidence":0.7}}},{"id":"d89b59ef-f47f-416a-aeaa-0f5fc67c4e38","from":"8b272c45-c506-438c-9f33-113e97d1b5f1","to":"b3da6ba5-5cb0-47ed-97c3-98d4e5f2598a","intensity":0.6,"link_type":{"Sem":{"verb":"认识","confidence":0.6}}},{"id":"