衷钦佩。"}},"mem_links":[{"id":"b5a240a3-f34b-433d-be04-1201d70acac6","from":"04443bc8-d9d4-470e-9322-b04f97f49c58","to":"8b272c45-c506-438c-9f33-113e97d1b5f1","intensity":0.9,"link_type":{"Sem":{"verb":"朋友","confidence":0.9}}}]}},{"embedding":{"tag":[-0.01266015,0.04013218,0.026723472,0.018386316,-0.025371851,-0.056937575,-0.01851907,0.02269205,0.046054453,-0.001337301,0.063741036,-0.3075862,-0.012982033,-0.057590377,-0.0018008505,0.016311456,-0.016816882,0.0025162883,0.014525193,-0.011528996,-0.012929537,-0.08373684,0.021102192,0.046881456,0.030136533,-0.027719954,0.01581083,-0.014648236,-0.022234783,-0.017903578,-0.031359136,-0.022005871,-0.0018016011,0.043275863,0.007975579,0.010096541,-0.005142862,0.01888891,-0.013540615,0.002602458,-0.0025202185,-0.053622983,0.039086998,-0.0051831864,-0.033939425,-0.02767299,-0.05453945,0.024735963,-0.025467046,0.043991208,-0.029263517,0.032937266,0.059636347,0.019117339,0.019156415,-0.061260216,0.011098177,0.03487656,0.012369344,0.04151554,-0.0119268885,-0.08321698,-0.05126667,-0.0113305515,0.03339714,-0.015441653,-0.013786948,-0.0018227156,0.010849525,0.027813926,0.0060282354,0.04876405,0.04904329,-0.0045103487,0.0090573,-0.058451302,-0.05528958,0.035275176,0.0055756094,0.0018960787,-0.0074373446,-0.026326777,-0.012733689,-0.00003899599,-0.07837999,-0.021104917,-0.038737215,0.0022155866,-0.049100034,-0.0074285446,0.007426763,-0.04898022,0.02406016,0.049961604,-0.058019787,0.014260789,-0.028389718,0.033582892,-0.03005242,0.060402773,0.049637012,-0.0068006963,-0.022838406,0.016461572,-0.040310524,-0.023783658,-0.044876143,-0.019383827,0.08176331,-0.009441446,0.04407448,0.017535277,-0.007362552,-0.05560019,0.017383382,0.024382085,0.01581743,0.03006352,0.0039805267,-0.051441275,-0.028879976,-0.017424352,0.014420927,-0.04125938,-0.043896444,-0.01987652,0.0016507576,-0.0006105851,0.009020275,0.017538846,0.07258007,0.05607313,-0.055580035,-0.021797063,0.0058443365,-0.0033448655,0.026158545,-0.083368495,-0.016328136,0.01167798,-0.011101