a2d39737d5","tags":["人物","前文明","托付者"],"retrieval_count":0,"create_time":"2026-07-16T15:12:55.592449900Z","last_accessed_time":"2026-07-16T15:12:55.592449900Z","mem_type":{"Semantic":{"content":"梅博士","aliases":["梅","前文明科学家","博士"],"concept_type":"Entity","description":"她是前文明最杰出的科学家，凯文的恋人。我曾因她不人道的实验和对卑弥呼之死的处理方式强烈谴责她，但末世之战时我理解了她所做的一切都是为了人类延续。她托付给我的火种计划，是我五万年来一直坚守的使命。"}},"mem_links":[{"id":"480127de-c4f2-4bf7-8b52-e54fe9ff6704","from":"c59a33de-89fb-4c94-bade-23a2d39737d5","to":"3683ea49-ce1e-4b2e-b9b7-57e9ef336b4c","intensity":0.8,"link_type":{"Sem":{"verb":"托付","confidence":0.8}}}]}},{"embedding":{"tag":[-0.004419107,0.0050915554,0.04718226,-0.00677483,-0.031559173,-0.051917452,-0.037451696,0.015096635,-0.01802622,0.015938805,0.0954656,-0.28938255,-0.021627633,-0.051992316,0.027227541,0.007294055,0.0014866069,-0.001377693,0.0013955223,0.0064112307,0.032336347,-0.085704006,-0.023080334,-0.017494552,-0.0014367091,-0.04562184,0.008778572,-0.06504107,-0.03804547,0.012717217,-0.020234361,-0.007675016,-0.020276183,0.03464797,0.013817284,0.017217683,0.0042602723,-0.028427878,0.02463904,0.009007354,-0.02681528,0.023690814,0.023120992,-0.062947355,-0.0012228895,-0.0075801224,-0.026403898,0.0046962253,-0.028450467,0.0005770214,-0.012306705,0.047299996,-0.020863244,0.06958567,0.009144393,-0.023350507,0.034381263,0.047787894,-0.010624307,0.023145467,0.009542731,-0.013839868,0.0008135575,0.0056447573,-0.031582113,-0.041642874,-0.020138709,0.0066412515,0.017533919,0.030266704,-0.003513213,0.0140704,-0.008012041,0.029275864,0.010886483,-0.03784651,-0.03722191,0.028818259,-0.008046541,0.0021291804,0.033999525,-0.042426664,-0.05442727,0.014865576,-0.030048454,-0.047677804,-0.046827924,-0.018666288,-0.030269206,0.0035884187,-0.014836539,-0.082321264,0.036479454,0.035023753,-0.016800636,-0.019456469,-0.04955483,0.013250022,-0.009177036,-0.01763828,-0.0022707626,0.0386128,0.04560883,0.023341715,-0.088698246,0.032433245,0.032234784,-0.005762449,0.0830822,-0.017540857,0.01343101,0.015216059