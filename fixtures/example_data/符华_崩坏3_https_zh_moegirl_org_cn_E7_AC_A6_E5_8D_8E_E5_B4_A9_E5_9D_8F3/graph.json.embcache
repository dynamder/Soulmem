,0.021181852,0.033162385,-0.02083501,-0.038850423,0.060639933,-0.0021157789,0.02437941,0.052817024,0.07129971,-0.024765214,-0.0011757406,-0.03629931,0.06561455,-0.015974393,-0.007195122,0.02451021,0.03807934,-0.010198188,-0.084448054,-0.006089984,-0.015966574,0.00020868577,-0.006270815,-0.046120416,0.023880946,-0.0702856,0.01647041,0.0010496047,0.086942405,-0.0012923955,-0.020356921,-0.000807783,0.0009812395]}}},"note":{"id":"3683ea49-ce1e-4b2e-b9b7-57e9ef336b4c","tags":["自身","角色"],"retrieval_count":0,"create_time":"2026-07-16T15:12:29.642402800Z","last_accessed_time":"2026-07-16T15:12:29.642402800Z","mem_type":{"Semantic":{"content":"符华","aliases":["华","赤鸢仙人","班长","老古董"],"concept_type":"Entity","description":"我是符华，曾用名华，也被人称作赤鸢仙人、班长。我来自五万年前已经毁灭的文明，一个名为逐火之蛾的组织中的普通士兵，后来成为了融合战士之一，位列逐火十三英桀第十二席，铭为「浮生」。我拥有不死之身，身体永远定格在十七岁，使用羽渡尘守护神州五千年，曾创立太虚剑派，收徒多人，经历太虚事变、第二次崩坏等重大事件。我以「守护」为信念，不断前行。"}},"mem_links":[{"id":"85cd3644-bf61-4f38-9c80-af070e5f3081","from":"3683ea49-ce1e-4b2e-b9b7-57e9ef336b4c","to":"e3aaab2d-581c-4659-8b20-56ca1b4f4c10","intensity":0.9,"link_type":{"Sem":{"verb":"指导","confidence":0.9}}},{"id":"df478dee-0725-48e4-8f7c-07b422da8267","from":"3683ea49-ce1e-4b2e-b9b7-57e9ef336b4c","to":"094c8848-d821-4c27-851b-a0a3ac6fb1b7","intensity":0.8,"link_type":{"Sem":{"verb":"指导","confidence":0.8}}},{"id":"b8fbdbf0-cffb-40ed-b95c-ee0d9c54867f","from":"3683ea49-ce1e-4b2e-b9b7-57e9ef336b4c","to":"1c8a0e6f-d168-427f-81d8-0d3a176b3a35","intensity":0.8,"link_type":{"Sem":{"verb":"指导","confidence":0.8}}},{"id":"2fb5a5b9-e372-406f-b2d4-af9c70cf0224","from":"3683ea49-ce1e-4b2e-b9b7-57e9ef336b4c","to":"ebaed388-a2eb-4137-b633-886f65a94461","intensity":0.9,"link_type":{"Sem":{"verb":"战友","confidence":0.9}}},{"id":"4443a78b-2ffe-4ace-a107-f828589df882","from":"3683ea49-ce1e-4b2e-b9b7-57e9ef336b4c","to":"46536bfd-0555-403d-9b2e-8dc7e3b01e9d","intensity":0.7,"link_type":{"Sem":{"verb":"下属","confidence":0.8}}},{"id":"490a587e-ce30-491b-8b6e-a788fa8a255b","from":"3683ea49-ce1e-4b2e-b9b7-57e9e