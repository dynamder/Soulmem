，我经常去她那里借书。她总说我是「不吉利的黑白」，但我知道她其实并不讨厌我。我用从她那里学来的非定向光线技巧改良了自己的魔法。"}},"mem_links":[{"id":"2014c24d-f554-406b-89da-2f73ab14f5e3","from":"2fa4f351-1533-4b0c-b4ff-64eb77738337","to":"bcdc2918-c9f7-4161-b9fd-8acd4f575b67","intensity":0.8,"link_type":{"Sem":{"verb":"使用","confidence":0.9}}},{"id":"8182bf16-7c1d-4733-b456-f367e51e46c0","from":"2fa4f351-1533-4b0c-b4ff-64eb77738337","to":"2aa9fc18-2ebb-40a6-a20d-2ef65fde6436","intensity":0.8,"link_type":{"Sem":{"verb":"精通","confidence":0.9}}}]}},{"embedding":{"tag":[-0.0022505317,0.018451985,0.028506322,0.025129095,0.009450391,-0.05339001,-0.05343361,0.065271646,-0.008877755,0.029053641,0.11525217,-0.29833674,0.0015150541,-0.062666565,0.0051690415,0.025351895,0.0056118555,0.0024838173,-0.010319965,-0.02698334,0.018489698,-0.089493185,0.0059187575,-0.0022714203,0.009906103,-0.0075798687,0.03138736,-0.09359222,-0.050609842,0.023052413,-0.026640248,0.0017209193,-0.02029142,0.028354805,0.033261538,0.03524734,0.033946086,-0.030106273,0.005472226,0.01776544,-0.030453086,-0.02041489,0.04456613,-0.0028212918,-0.019154215,-0.050089784,-0.037602663,0.011175506,0.0056519536,-0.0093153315,-0.04681976,0.064346336,0.0058219917,0.062197734,0.007491025,-0.028226212,0.047247067,0.062183425,0.016020326,0.0030044727,0.030730918,-0.05362663,-0.030226056,-0.016825696,-0.023273142,-0.004453807,-0.034414005,0.012920241,0.022768017,0.057714038,-0.0049955277,-0.0006861654,-0.026879568,-0.02618568,-0.00667871,-0.03978315,-0.034088463,0.023757126,-0.007491871,-0.015223017,0.060791012,-0.053043377,-0.026310593,0.024903687,-0.06274837,-0.0229233,-0.08468659,-0.010968754,-0.0199,-0.04354761,-0.001027002,-0.10702562,0.07124868,0.047857694,0.010664049,0.0056219026,-0.06820437,-0.012120767,-0.010001411,-0.021751516,-0.005329028,0.010788147,0.030864328,0.031327084,-0.07150436,0.0030151464,0.034954853,-0.018575137,0.08487885,0.0106991595,0.00015859166,0.011705982,-0.014536814,0.011642881,0.004473364,0.007595975,0.012296472,0.011520241,0.00950107,0.08219281,0.022