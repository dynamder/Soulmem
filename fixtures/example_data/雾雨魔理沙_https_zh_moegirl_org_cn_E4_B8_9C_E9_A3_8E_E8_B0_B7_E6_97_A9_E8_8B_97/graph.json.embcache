照自己喜欢的方式生活。"}},"mem_links":[{"id":"b45382d6-c4dd-4bca-9639-3031b983533b","from":"3fa6bd96-190d-4963-8007-3d7be60eac4a","to":"f93b2095-f101-417f-b2c1-098e936fe224","intensity":0.9,"link_type":{"Sem":{"verb":"是友人","confidence":0.9}}},{"id":"56ad5b0c-e948-4abf-9197-f15d8d4caf32","from":"3fa6bd96-190d-4963-8007-3d7be60eac4a","to":"c170bd4d-0bd2-45fd-a6fb-6614fba83821","intensity":0.8,"link_type":{"Sem":{"verb":"是好友","confidence":0.8}}},{"id":"a2667855-a6da-4987-8c76-02e37b5f7cd5","from":"3fa6bd96-190d-4963-8007-3d7be60eac4a","to":"2fa4f351-1533-4b0c-b4ff-64eb77738337","intensity":0.7,"link_type":{"Sem":{"verb":"是朋友","confidence":0.7}}},{"id":"e7842a60-5f9f-47df-a3d7-01aa9a2aea91","from":"3fa6bd96-190d-4963-8007-3d7be60eac4a","to":"5f3425ac-0021-4866-b738-2bbd796664e3","intensity":0.9,"link_type":{"Sem":{"verb":"是亲友","confidence":0.9}}},{"id":"3a797e90-cf93-453e-8e72-2e712a83a7f5","from":"3fa6bd96-190d-4963-8007-3d7be60eac4a","to":"097d05f1-3840-44e1-af59-aa7ed5f8234d","intensity":0.6,"link_type":{"Sem":{"verb":"是旧识","confidence":0.6}}},{"id":"710d212a-3dec-4828-a713-e1eaafa63941","from":"3fa6bd96-190d-4963-8007-3d7be60eac4a","to":"983c5bfa-4c68-4c94-8573-aafc096f2d2b","intensity":0.6,"link_type":{"Sem":{"verb":"是同行","confidence":0.6}}},{"id":"930581de-cc30-496a-b6f0-8a1e8f33f868","from":"3fa6bd96-190d-4963-8007-3d7be60eac4a","to":"edf58068-405a-4c53-8222-e7e3089dcb1e","intensity":0.5,"link_type":{"Sem":{"verb":"是父亲","confidence":0.5}}},{"id":"e3dd8e07-82ea-4de6-955e-dbeae8b2cb1d","from":"3fa6bd96-190d-4963-8007-3d7be60eac4a","to":"1fd5cfab-42fb-4399-ba0e-6c4321bb7dc8","intensity":0.9,"link_type":{"Sem":{"verb":"生活在","confidence":0.9}}},{"id":"160d3aab-7d31-4899-9502-0c2baffe5452","from":"3fa6bd96-190d-4963-8007-3d7be60eac4a","to":"4f709618-5b7f-4101-96e3-3ea066f0e5e8","intensity":0.9,"link_type":{"Sem":{"verb":"居住在","confidence":0.9}}},{"id":"e2473fcf-1703-4145-920e-2bf9efa004e3","from":"3fa6bd96-190d-4963-8007-3d7be60eac4a","to":"523954ad-0295-4c0f-b21f-b60ba7627d7f","