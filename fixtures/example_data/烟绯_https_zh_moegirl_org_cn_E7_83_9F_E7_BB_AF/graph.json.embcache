7508887,0.005274661]}}},"note":{"id":"3df9fb83-4bf2-4472-9e95-c007d93589ee","tags":["人物","父亲"],"retrieval_count":0,"create_time":"2026-07-16T15:09:44.373662Z","last_accessed_time":"2026-07-16T15:09:44.373662Z","mem_type":{"Semantic":{"content":"我的父亲（仙兽）","aliases":["老爹","仙人父亲"],"concept_type":"Entity","description":"他是个通透潇洒的人，当初陪帝君打完仗就跑回家结婚，生下我之后把我丢给萍姥姥，自己云游天下。他留给我一杆帝君钦赐的宝秤。他似乎知道钟离先生的秘密但不愿意告诉我。我和他订的契约是'要快乐地生活'。"}},"mem_links":[{"id":"3aff627a-7273-4675-81af-b7661644b2b4","from":"3df9fb83-4bf2-4472-9e95-c007d93589ee","to":"930f31f8-8e6e-428a-be25-72022b835da9","intensity":0.9,"link_type":{"Sem":{"verb":"给予","confidence":0.9}}},{"id":"5cc81485-bbc8-4bb5-8c66-76f6189e983a","from":"3df9fb83-4bf2-4472-9e95-c007d93589ee","to":"f07dc263-0a2e-4dbe-8b00-b24600db3104","intensity":1.0,"link_type":{"Sem":{"verb":"传承血脉","confidence":1.0}}}]}},{"embedding":{"tag":[-0.029330252,-0.015191454,0.042737067,-0.01777223,0.027934358,-0.042774577,-0.03503886,0.06283201,0.002891142,0.029702801,0.08753537,-0.27250567,-0.033514693,-0.03250874,0.016570691,0.028594434,-0.030032763,-0.018731872,0.023021393,-0.02744856,0.04477952,-0.054863803,-0.016996559,0.0060803425,-0.0042802244,-0.011296235,0.03969974,-0.049307734,-0.05864781,0.026989466,-0.029884607,0.021759652,0.020155545,-0.007086683,0.062687084,0.038295306,0.0368337,0.00015152479,-0.025967268,-0.013339653,-0.05123298,-0.0012371456,0.029100223,-0.012873446,-0.014321112,-0.013065826,-0.027223457,-0.00902291,0.0052946904,-0.04020145,-0.047327466,0.085889444,-0.0014374037,0.043323018,0.008974223,-0.035368297,0.027337402,0.07837199,-0.00140459,0.029615069,0.0074048424,-0.009501279,-0.0071385335,0.0087038465,-0.038362075,-0.014995226,-0.025798436,-0.017343912,0.03768146,0.023181587,-0.0508158,0.022059638,0.031496756,-0.009992744,0.018678801,-0.037280884,-0.025227644,0.026287757,0.006946,-0.04234116,0.036459815,-0.073246285,-0.026504118,-0.022192663,-0.06653571,-0.050392132,-0.08706348,0.0044715498,0.008136561,-0.019731201,0.014300239,-0.081799