T15:15:39.736981500Z","mem_type":{"Situation":{"SpecificSituation":{"narrative":"有一次，一块陨石笔直地朝着红魔馆飞来，我只是“啪的一下就轰隆——”地把它弄爆炸了而已。对我来说，那种程度的东西随便一捏就碎了。射命丸文后来还采访了我关于这次陨石爆炸的事。","time_span":"1970-01-01T00:00:00Z","context":{"location":{"name":"红魔馆上空","coordinates":"幻想乡-雾之湖-红魔馆"},"participants":[{"name":"我","role":"破坏者"},{"name":"姐姐大人","role":"旁观者"}],"emotions":[{"name":"轻松","intensity":0.9},{"name":"满足","intensity":0.7}],"sensory_data":[{"name":"爆炸声","intensity":0.9},{"name":"闪光","intensity":0.8}],"environment":{"atmosphere":"紧张但迅速解决","tone":"喧嚣"},"event":[{"action":"陨石坠落","action_intensity":0.8,"initiator":"自然现象","target":"红魔馆"},{"action":"破坏陨石","action_intensity":1.0,"initiator":"我","target":"陨石"}]}}}},"mem_links":[{"id":"46c3fe00-be9b-4ca8-b684-bf755e8170c6","from":"ad40121d-084a-451c-ac72-aa8afd0e7dd2","to":"23b30bf6-f15b-4b79-b57e-cea67693ba4f","intensity":1.0,"link_type":{"Sem":{"verb":"参与","confidence":1.0}}},{"id":"39ee6e74-5707-4788-8ec5-da28b51ec78c","from":"ad40121d-084a-451c-ac72-aa8afd0e7dd2","to":"c7ccef71-f6d3-44b6-954b-23d00b9dfb8f","intensity":0.7,"link_type":{"Sem":{"verb":"在场","confidence":0.8}}},{"id":"2ab07a1e-060c-4aab-804d-b030ee8d84d1","from":"ad40121d-084a-451c-ac72-aa8afd0e7dd2","to":"086ea81a-8599-478a-bf29-feb5271362c4","intensity":0.4,"link_type":{"Sem":{"verb":"被采访","confidence":0.6}}}]}},{"embedding":{"tag":[0.02167725,-0.00010068078,0.009427561,-0.028251521,-0.021218738,-0.035811666,-0.024533583,0.029520616,0.005334223,0.023316547,0.08064859,-0.28028902,0.0010971079,-0.009554467,-0.0057357526,0.01624384,-0.016842796,-0.016148029,-0.014468588,-0.044293333,0.050257888,-0.02088586,-0.0048173466,0.016760658,0.015953297,0.015465204,-0.02219296,0.00025195224,-0.037721485,-0.010150018,-0.036022242,0.0042422917,0.011283812,-0.0016207272,0.00018630177,-0.025279323,-0.017829306,0.0030059991,0.0038856373,0.04089917,-0.016922994,-0.034962673,-0.002008111,0.01376146,0.020050002,0.0039480426,-0.05696091,0.035519037,-0.029415578,0.009007947,-0.019288413,0.045