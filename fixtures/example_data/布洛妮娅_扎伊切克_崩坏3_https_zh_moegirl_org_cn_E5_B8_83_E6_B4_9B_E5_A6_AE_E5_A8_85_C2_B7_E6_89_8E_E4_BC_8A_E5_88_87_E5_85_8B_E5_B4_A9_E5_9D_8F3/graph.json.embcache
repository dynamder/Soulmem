":{"id":"53866aca-3881-48ee-8b0b-9e49e06a292c","tags":["人物","养母"],"retrieval_count":0,"create_time":"2026-07-16T14:59:31.782673900Z","last_accessed_time":"2026-07-16T14:59:31.782673900Z","mem_type":{"Semantic":{"content":"可可利亚","aliases":["可可利亚妈妈","养母","孤儿院院长"],"concept_type":"Entity","description":"可可利亚是布洛妮娅的养母。布洛妮娅曾奉命暗杀她，但可可利亚没有杀她反而收养了她。她建立了可可利亚孤儿院。但她后来背叛了布洛妮娅，在她脑中植入生物芯片控制她，策划了Project-Mei。布洛妮娅恨过她，但回来后看到被监禁的她把孤儿院托付给自己，布洛妮娅心里仍然把她当作母亲，感情复杂。"}},"mem_links":[{"id":"75682e34-60ae-4351-846a-1953e32faff5","from":"53866aca-3881-48ee-8b0b-9e49e06a292c","to":"3d24bf2a-1bf3-4bc8-81fb-a07aedc06681","intensity":0.7,"link_type":{"Sem":{"verb":"养女","confidence":0.7}}},{"id":"7fb9f9d0-f78d-47ad-bb96-b98e16fbcb52","from":"53866aca-3881-48ee-8b0b-9e49e06a292c","to":"95197a7c-7a28-4dbb-8d09-f675a1b683aa","intensity":0.8,"link_type":{"Sem":{"verb":"主导实验","confidence":0.8}}},{"id":"a014b11e-29cb-433e-af3d-28b0b997b957","from":"53866aca-3881-48ee-8b0b-9e49e06a292c","to":"068a3c41-f64d-410c-986e-75091758ac69","intensity":0.9,"link_type":{"Sem":{"verb":"建立","confidence":0.9}}}]}},{"embedding":{"tag":[-0.03745147,-0.025610203,0.031730436,-0.021602059,0.006891873,-0.056205288,-0.039517332,0.061275538,0.015987115,0.019287271,0.06984047,-0.27068812,-0.032469645,-0.015111369,0.027908094,0.0019953884,-0.023332335,-0.023192616,0.003701359,0.022957714,0.055511802,-0.080427565,0.017917985,-0.00842519,0.019962138,0.01018454,0.025948342,-0.047229514,-0.018249629,-0.0060539693,-0.022665322,0.038501672,0.02310514,0.051214054,0.03977029,0.04279756,0.031238412,-0.033365153,-0.025589336,-0.015108109,-0.025781753,0.0013295533,0.015249255,0.007935864,-0.000032118056,-0.027456868,-0.033529043,0.017798088,0.024624594,-0.02591834,-0.03894702,0.056789927,-0.0010364386,0.048741613,-0.0044098506,-0.054307863,0.039664503,0.049556397,-0.015309514,0.004657792,-0.003151631,-0.009541814,-0.00088282116,0.01260294,-0.011670612,-0.018952502,-0.028450634,-0.027292822,0.03121907,0.030154128,-0.023400031,-0.013871545,-0.01