            "minLength": 1
          },
          "to": {
            "minLength": 1
          },
          "relation": {
            "minLength": 1
          },
          "intensity": {
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
